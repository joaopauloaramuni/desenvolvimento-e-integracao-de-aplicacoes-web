# Copie este arquivo para .env.local e preencha (o .env.local NÃO vai para o GitHub):
#   cp .env.example .env.local
#
# Sem o prefixo VITE_ de propósito: o token é lido só no servidor
# (vite.config.js no npm run dev e api/github.js na Vercel) e nunca vai para o navegador.

# Token do GitHub (fine-grained com "Contents: Read-only" ou classic com o escopo "repo")
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxx

# Opcional: donos permitidos (usuários/organizações), separados por vírgula.
# Se o site for publicado, limita quais repositórios o servidor aceita analisar.
GITHUB_ALLOWED_OWNERS=
