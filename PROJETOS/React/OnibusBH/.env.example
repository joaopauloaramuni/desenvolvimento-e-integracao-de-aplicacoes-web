# Feed GTFS-Realtime da PBH (posição dos ônibus em tempo real).
# Copie a URL COMPLETA, com a chave, do recurso "vehicle-positions" em:
# https://dados.pbh.gov.br/dataset/gtfs-rt
# Sem esta variável o site funciona normalmente, só sem os ônibus ao vivo no mapa.
PBH_GTFS_RT_URL=

# Opcional: outra URL para o GTFS estático (linhas, pontos, trajetos e horários),
# usada pelo npm run dados. O padrão está em src/config/appConfig.js.
PBH_GTFS_URL=
