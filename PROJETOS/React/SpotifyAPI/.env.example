# Copie para .env.local (cp .env.example .env.local) e preencha.
# NÃO use o prefixo VITE_: as chaves são secretas e são lidas só no servidor
# (vite.config.js no npm run dev e api/spotify.js na Vercel).

# Do app criado em https://developer.spotify.com/dashboard (Settings → Basic Information)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Gerado UMA vez pelo próprio projeto: rode npm run dev, abra
# http://127.0.0.1:5173/api/spotify/login, autorize e copie o token da tela.
SPOTIFY_REFRESH_TOKEN=
