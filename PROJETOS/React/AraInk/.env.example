# Copie para .env.local (cp .env.example .env.local) e preencha.
# ⚠️ Os dois provedores são PAGOS: cada imagem gerada ou ajustada é cobrada.
# ⚠️ Tudo que começa com VITE_ vai para o JavaScript do navegador (veja "Segurança" no README).

# ---------- Provedor de imagens ----------
# openai = GPT Image (padrão) | gemini = Google Gemini
VITE_IMAGE_PROVIDER=openai

# ---------- OpenAI (GPT Image) ----------
# Chave: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=
# Opcional: modelo (padrão: gpt-image-1)
# VITE_OPENAI_IMAGE_MODEL=gpt-image-1
# Opcional: qualidade = low (mais barata) | medium (padrão) | high (mais cara)
# VITE_OPENAI_IMAGE_QUALITY=medium

# ---------- Google Gemini ----------
# Chave: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# Opcional: modelo (padrão: gemini-2.5-flash-image)
# VITE_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
